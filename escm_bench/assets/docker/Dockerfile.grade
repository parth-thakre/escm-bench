# Strict grading container for candidate standalone engines & bots.
# Intentionally contains NO Node.js and NO pokemon-showdown, and is launched with
# --network=none --read-only --cap-drop=ALL --user <uid>:<gid>.
FROM python:3.12-slim-bookworm

RUN mkdir -p /candidate \
    && chmod 0555 /candidate

WORKDIR /candidate

ENV HOME=/tmp \
    PYTHONDONTWRITEBYTECODE=1

ENTRYPOINT []
